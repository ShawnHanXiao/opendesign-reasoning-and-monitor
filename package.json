{
  "name": "opendesign-reasoning-and-monitor",
  "version": "0.1.0",
  "description": "OpenDesign in DSH: automatically repairs reasoning-effort levels for OpenDesign models, and shows the 5h / 7d / billing-period quota as a pill in the conversation header. · 为 OpenDesign 模型自动补齐思考深度档位，并在会话右上角显示三档额度用量。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "opendesign",
    "quota",
    "reasoning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badai147/opendesign-reasoning-and-monitor.git"
  },
  "homepage": "https://github.com/badai147/opendesign-reasoning-and-monitor#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
